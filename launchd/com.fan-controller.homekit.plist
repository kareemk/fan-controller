<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd service for the fan-controller HomeKit bridge (macOS, e.g. an
  always-on Mac mini with the HackRF attached).

  Setup:
    1. Build the release binary:  cargo build --release
    2. Edit the ABSOLUTE paths below to match this machine (binary, config,
       working directory, log files). The __REPO__ token appears in each.
    3. Install as a per-user agent (runs when this user is logged in; enable
       auto-login on the Mac mini so it starts after a reboot):
         cp launchd/com.fan-controller.homekit.plist ~/Library/LaunchAgents/
         launchctl load ~/Library/LaunchAgents/com.fan-controller.homekit.plist
    4. Logs: tail -f __REPO__/homekit.log

  To stop / reload:
    launchctl unload ~/Library/LaunchAgents/com.fan-controller.homekit.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.fan-controller.homekit</string>

    <key>ProgramArguments</key>
    <array>
        <string>__REPO__/target/release/fan-tx</string>
        <string>--driver</string>
        <string>hackrf</string>
        <string>--homekit</string>
        <string>--config</string>
        <string>__REPO__/config.yaml</string>
        <string>--repeat</string>
        <string>1</string>
    </array>

    <!-- Relative paths in the app resolve against this dir. -->
    <key>WorkingDirectory</key>
    <string>__REPO__</string>

    <!-- SoapySDR finds its modules via a compiled-in path, but keep Homebrew
         on PATH for good measure. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <!-- Start at login and restart if it ever exits. -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>__REPO__/homekit.log</string>
    <key>StandardErrorPath</key>
    <string>__REPO__/homekit.log</string>
</dict>
</plist>
